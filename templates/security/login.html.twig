{% extends 'security/layout.html.twig' %}

{% block headTitle %}
{{ 'Login'|trans }}
{% endblock %}

{% block pageTitle %}
{{ 'Login'|trans }}
{% endblock %}

{% block pageContent %}
                  <form method="POST" class="needs-validation" novalidate="">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
{% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

                    <div class="form-floating mb-3">
                      <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" placeholder="name@example.com" required autofocus />
                      <label for="username">{{ 'Email'|trans }}</label>
                    </div>

                    <div class="form-floating mb-3">
                      <input class="form-control" type="password" id="password" name="_password" placeholder="Password" />
                      <label for="password">{{ 'Password'|trans }}</label>
                    </div>

                    <div class="form-check mb-3">
                      <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me" checked />
                      <label class="form-check-label" for="_remember_me">{{ 'Remember Me'|trans }}</label>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                      <span>&nbsp;</span>
                      {# <a class="small" href="password.html">{{ 'Forgot Your Password?'|trans }}</a> #}
                      <button type="submit" class="btn btn-primary" tabindex="4">{{ 'Login'|trans }}</button>
                    </div>
                  </form>
{% endblock %}
